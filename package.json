{
  "name": "joys-store",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "test:ci": "jest --ci --runInBand",
    "test:e2e": "npm run test:e2e:demo && npm run test:e2e:live",
    "test:e2e:demo": "E2E_MODE=demo playwright test",
    "test:e2e:live": "E2E_MODE=live playwright test",
    "test:e2e:deployed": "E2E_DEPLOYED=1 E2E_MODE=demo playwright test",
    "check": "npm run lint && npm run test:ci && npm run build"
  },
  "dependencies": {
    "@babel/runtime": "7.29.10",
    "@chec/commerce.js": "2.8.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "@stripe/react-stripe-js": "7.0.1",
    "@stripe/stripe-js": "10.2.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-x": "5.28.8",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2"
  },
  "overrides": {
    "@chec/commerce.js": {
      "axios": "0.34.0"
    }
  }
}
