# Copy to an ignored .env.local; never commit real secret values.
NEXT_PUBLIC_COMMERCE_MODE=demo
# local is the credential-free simulation; remote uses the Node.js order service.
NEXT_PUBLIC_DEMO_ORDER_STORAGE=local
# Server-only settings for remote orders (never NEXT_PUBLIC_ credentials).
ORDERS_API_URL=
ORDERS_API_SECRET=
# Local integration tests only. Rejected on Vercel.
ORDERS_ALLOW_LOCAL_API=false
# These keys are only used when mode is explicitly set to live.
NEXT_PUBLIC_COMMERCE_PUBLIC_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
