# Copy to an ignored .env.local; never commit real secret values.
NEXT_PUBLIC_CATALOG_PROVIDER=seeded
# stripe + seeded catalog + remote orders selects hosted Stripe test checkout.
NEXT_PUBLIC_PAYMENT_PROVIDER=simulated
# local is the credential-free simulation; remote uses the Node.js order service.
NEXT_PUBLIC_ORDER_STORAGE=local
# Legacy COMMERCE_MODE / DEMO_ORDER_STORAGE settings remain supported when the
# corresponding provider settings above are absent. Explicit settings take priority.
# Server-only settings for remote orders (never NEXT_PUBLIC_ credentials).
ORDERS_API_URL=
ORDERS_API_SECRET=
# Local integration tests only. Rejected on Vercel.
ORDERS_ALLOW_LOCAL_API=false
# Legacy Commerce.js integration only: catalog=commercejs, payment=stripe,
# order storage=commercejs. Hosted Stripe test checkout needs neither browser key.
# Its STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET belong only in Ecommerce-Orders.
NEXT_PUBLIC_COMMERCE_PUBLIC_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional private merchant workspace. These are server-only configuration.
# Keep disabled for ordinary local demos and previews without separate auth setup.
MERCHANT_AUTH_ENABLED=false
# Fixed storefront origin; must match the backend BETTER_AUTH_URL.
# Local HTTP also needs ORDERS_ALLOW_LOCAL_API=true above.
MERCHANT_AUTH_ORIGIN=http://127.0.0.1:3000
MERCHANT_GOOGLE_ENABLED=false
# Better Auth/GitHub credentials and the merchant allowlist belong only in
# Ecommerce-Orders. ORDERS_API_SECRET does not grant merchant access.

# Optional shopper Google accounts. Remote order storage is required for My orders.
# The backend owns Google credentials and the independent customer session secret.
CUSTOMER_AUTH_ENABLED=false
CUSTOMER_AUTH_ORIGIN=http://127.0.0.1:3000
